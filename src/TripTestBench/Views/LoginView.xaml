<UserControl x:Class="TripTestBench.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TripTestBench.Converters"
             FontFamily="Microsoft YaHei UI">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Background="{StaticResource B.WindowBg}">
        <!-- 背景光晕 -->
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="760" Height="760" Canvas.Left="-260" Canvas.Top="-320">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2200C8FF" Offset="0" />
                        <GradientStop Color="#0000C8FF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="620" Height="620" Canvas.Right="-180" Canvas.Bottom="-260">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#1A18C98B" Offset="0" />
                        <GradientStop Color="#0018C98B" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Width="440"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Style="{StaticResource Card}"
                    Padding="38,34,38,30">
                <StackPanel>
                    <Border Width="54" Height="54" CornerRadius="14" Background="{StaticResource B.AccentDim}"
                            BorderBrush="{StaticResource B.Accent}" BorderThickness="1"
                            HorizontalAlignment="Center">
                        <Path Data="M 7,0 L 0,13 L 5,13 L 3,24 L 12,9 L 6,9 Z"
                              Fill="{StaticResource B.Accent}"
                              Width="15" Height="24"
                              Stretch="Fill"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="{DynamicResource L.App.Title}"
                               FontSize="26"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,0" />

                    <TextBlock Text="{DynamicResource L.Login.Subtitle}"
                               Style="{StaticResource CaptionText}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0" />

                    <Border Height="1" Background="{StaticResource B.Border}" Margin="0,26,0,22" />

                    <TextBlock Text="{DynamicResource L.Login.Welcome}" FontSize="17" FontWeight="SemiBold" />

                    <TextBlock Text="{DynamicResource L.Login.UserName}" Style="{StaticResource FieldLabel}" Margin="0,22,0,7" />
                    <TextBox x:Name="UserNameBox"
                             Style="{StaticResource InputTextBox}"
                             Height="48"
                             FontSize="16"
                             Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="{DynamicResource L.Login.Password}" Style="{StaticResource FieldLabel}" Margin="0,16,0,7" />
                    <PasswordBox x:Name="PasswordBox"
                                 Style="{StaticResource InputPasswordBox}"
                                 Height="48"
                                 FontSize="16"
                                 PasswordChanged="PasswordBox_OnPasswordChanged" />

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource B.Danger}"
                               FontSize="12"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

                    <Button Content="{DynamicResource L.Login.Button}"
                            Style="{StaticResource PrimaryButton}"
                            Height="52"
                            FontSize="17"
                            Margin="0,22,0,0"
                            IsDefault="True"
                            Command="{Binding LoginCommand}" />

                    <TextBlock Text="{DynamicResource L.Login.Hint}"
                               Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="1"
                       Text="{DynamicResource L.App.Version}"
                       Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,18" />
        </Grid>
    </Grid>
</UserControl>
