<Window x:Class="TripTestBench.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="480"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI">

    <Border Margin="20"
            Background="{StaticResource B.Card}"
            BorderBrush="{StaticResource B.Border}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="26,20,26,22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.55" Color="#FF000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText"
                       Grid.Row="0"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource B.Text}"
                       MouseLeftButtonDown="Header_OnMouseLeftButtonDown" />

            <Border Grid.Row="1" Height="1" Background="{StaticResource B.Border}" Margin="0,14,0,16" />

            <TextBlock Grid.Row="2"
                       TextWrapping="Wrap"
                       FontSize="14"
                       LineHeight="24"
                       Foreground="{StaticResource B.TextSecondary}"
                       Text=""
                       Name="MessageText" />

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0">
                <Button x:Name="CancelButton"
                        Content="{DynamicResource L.Button.Cancel}"
                        Style="{StaticResource GhostButton}"
                        Width="100"
                        Height="40"
                        Margin="0,0,10,0"
                        Click="Cancel_OnClick" />
                <Button Content="{DynamicResource L.Button.Confirm}"
                        Style="{StaticResource PrimaryButton}"
                        Width="120"
                        Height="40"
                        IsDefault="True"
                        Click="Ok_OnClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
