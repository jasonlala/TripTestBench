<UserControl x:Class="TripTestBench.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TripTestBench.Converters"
             FontFamily="Microsoft YaHei UI">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:IntEqualsConverter x:Key="IntEquals" />
        <conv:SecondsToTimeConverter x:Key="SecondsToTime" />
        <conv:ErrorToBrushConverter x:Key="ErrorToBrush" />
    </UserControl.Resources>

    <Grid Background="{StaticResource B.WindowBg}">
        <Grid Margin="18,14,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Grid Grid.Row="0" Margin="4,0,4,14">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{DynamicResource L.Button.Back}"
                            Style="{StaticResource GhostButton}"
                            Height="42"
                            Command="{Binding BackCommand}" />
                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource L.History.Title}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="{DynamicResource L.History.Subtitle}"
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <!-- 导出 Excel：11 列数据 + 曲线截图，直接可用 Excel 打开 -->
                    <Button Content="{DynamicResource L.Button.ExportExcel}"
                            Style="{StaticResource PrimaryButton}"
                            Height="42"
                            Command="{Binding ExportExcelCommand}" />
                    <!-- 打印：把当前筛选结果发送到打印机（A4 横向报表） -->
                    <Button Content="{DynamicResource L.Button.Print}"
                            Style="{StaticResource GhostButton}"
                            Height="42"
                            Margin="10,0,0,0"
                            Command="{Binding PrintCommand}" />
                </StackPanel>
            </Grid>

            <!-- 筛选 -->
            <Border Grid.Row="1" Style="{StaticResource CardAlt}" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource L.History.Range}"
                               Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <RadioButton Content="{DynamicResource L.History.Range.All}"
                                     GroupName="Range"
                                     Style="{StaticResource SegmentRadio}"
                                     Width="82"
                                     IsChecked="{Binding RangeIndex, Converter={StaticResource IntEquals}, ConverterParameter=0, Mode=TwoWay}" />
                        <RadioButton Content="{DynamicResource L.History.Range.Today}"
                                     GroupName="Range"
                                     Style="{StaticResource SegmentRadio}"
                                     Width="82"
                                     Margin="6,0,0,0"
                                     IsChecked="{Binding RangeIndex, Converter={StaticResource IntEquals}, ConverterParameter=1, Mode=TwoWay}" />
                        <RadioButton Content="{DynamicResource L.History.Range.Week}"
                                     GroupName="Range"
                                     Style="{StaticResource SegmentRadio}"
                                     Width="82"
                                     Margin="6,0,0,0"
                                     IsChecked="{Binding RangeIndex, Converter={StaticResource IntEquals}, ConverterParameter=2, Mode=TwoWay}" />
                        <RadioButton Content="{DynamicResource L.History.Range.Month}"
                                     GroupName="Range"
                                     Style="{StaticResource SegmentRadio}"
                                     Width="82"
                                     Margin="6,0,0,0"
                                     IsChecked="{Binding RangeIndex, Converter={StaticResource IntEquals}, ConverterParameter=3, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="24,0,24,0">
                        <TextBlock Text="{DynamicResource L.History.Keyword}"
                                   Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <TextBox Style="{StaticResource InputTextBox}"
                                 Height="36"
                                 Width="280"
                                 Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{DynamicResource L.History.KeywordHint}" />
                        <TextBlock Text="{DynamicResource L.History.KeywordHint}"
                                   Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Content="{DynamicResource L.Button.Search}"
                                Style="{StaticResource PrimaryButton}"
                                Height="36"
                                MinWidth="92"
                                Command="{Binding SearchCommand}" />
                        <Button Content="{DynamicResource L.Button.Reset}"
                                Style="{StaticResource GhostButton}"
                                Height="36"
                                MinWidth="80"
                                Margin="10,0,0,0"
                                Command="{Binding ResetCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 统计 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,12">
                <Border Style="{StaticResource CardAlt}" Width="170" Padding="18,10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.History.Total}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding TotalCount}"
                                   FontFamily="Consolas"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource B.Accent}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 记录列表 -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <DataGrid x:Name="RecordGrid"
                              Style="{StaticResource DataGridStyle}"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                              MouseDoubleClick="RecordGrid_OnMouseDoubleClick"
                              Margin="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource L.History.Col.Time}"
                                                Binding="{Binding TestTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                                Width="168" />
                            <DataGridTextColumn Header="{DynamicResource L.History.Col.ProductName}"
                                                Binding="{Binding ProductName}"
                                                Width="160" />
                            <DataGridTextColumn Header="{DynamicResource L.History.Col.ProductCode}"
                                                Binding="{Binding ProductCode}"
                                                Width="160" />
                            <DataGridTextColumn Header="{DynamicResource L.History.Col.Tester}"
                                                Binding="{Binding Tester}"
                                                Width="90" />
                            <DataGridTextColumn Header="{DynamicResource L.History.Col.SetCurrent}"
                                                Binding="{Binding SetCurrentKa, StringFormat={}{0:F2}}"
                                                Width="112" />
                            <DataGridTextColumn Header="{DynamicResource L.History.Col.SetTime}"
                                                Binding="{Binding SetTimeSeconds, Converter={StaticResource SecondsToTime}}"
                                                Width="104" />
                            <DataGridTextColumn Header="{DynamicResource L.History.Col.RunTime}"
                                                Binding="{Binding RunTimeSeconds, StringFormat={}{0:F2}}"
                                                Width="104" />

                            <!-- 曲线截图：有截图时显示“查看”按钮，点击弹出预览 -->
                            <DataGridTemplateColumn Header="{DynamicResource L.History.Col.Chart}" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{DynamicResource L.Button.ViewChart}"
                                                Style="{StaticResource GhostButton}"
                                                Height="24"
                                                Width="72"
                                                HorizontalAlignment="Center"
                                                Padding="0"
                                                FontSize="11"
                                                Command="{Binding DataContext.ViewChartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding HasChartImage, Converter={StaticResource BoolToVisibility}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="{DynamicResource L.History.Empty}"
                               FontSize="14"
                               Foreground="{StaticResource B.TextMuted}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                    <Border VerticalAlignment="Bottom"
                            HorizontalAlignment="Right"
                            Margin="0,0,16,14"
                            Padding="14,8"
                            CornerRadius="6"
                            Background="#F0101C29"
                            BorderBrush="{StaticResource B.Border}"
                            BorderThickness="1"
                            Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   MaxWidth="720"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding StatusIsError, Converter={StaticResource ErrorToBrush}}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
