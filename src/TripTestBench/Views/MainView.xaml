<UserControl x:Class="TripTestBench.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TripTestBench.Controls"
             xmlns:conv="clr-namespace:TripTestBench.Converters"
             FontFamily="Microsoft YaHei UI">

    <UserControl.Resources>
        <!-- 布尔 → 可见性：用于提示条的显示 / 隐藏 -->
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- 合格标记 → 颜色：用于结果文字着色 -->
        <conv:PassedToBrushConverter x:Key="PassedToBrush" />

        <!--
            PLC 连接状态指示灯样式：
            · 已连接：灯珠常亮，绿色；
            · 通讯中断：灯珠红色并 0.55 秒一次呼吸闪烁，便于远距离发现。
        -->
        <Style x:Key="PlcLampStyle" TargetType="Ellipse">
            <Setter Property="Opacity" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PlcConnected}" Value="False">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="PlcLampBlink">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.12" Duration="0:0:0.55" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="PlcLampBlink" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource B.WindowBg}">
        <Grid Margin="18,14,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===================== 顶部标题栏 ===================== -->
            <Grid Grid.Row="0" Margin="4,0,4,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="4" Height="24" CornerRadius="2" Background="{StaticResource B.Accent}" />
                        <TextBlock Text="{DynamicResource L.App.Title}"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource L.App.Subtitle}"
                               Style="{StaticResource CaptionText}"
                               Margin="14,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ClockText}"
                               FontFamily="Consolas"
                               FontSize="19"
                               Foreground="{StaticResource B.TextSecondary}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- ============ PLC 连接状态检测指示灯 ============ -->
                    <!-- 外圈光晕 + 内层灯珠：颜色随连接状态变化，断线时红色闪烁 -->
                    <Border Style="{StaticResource CardAlt}" Padding="12,7" CornerRadius="18">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <!-- 外层光晕：半透明，扩大视觉提醒范围 -->
                                <Ellipse Fill="{Binding PlcStatusBrush}" Opacity="0.20" />
                                <!-- 内层灯珠：绿=已连接 / 红闪=断开 -->
                                <Ellipse Width="9"
                                         Height="9"
                                         Fill="{Binding PlcStatusBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Style="{StaticResource PlcLampStyle}" />
                            </Grid>
                            <TextBlock Text="{Binding PlcStatusText}"
                                       Margin="8,0,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding PlcStatusBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- ============ 设备状态指示灯组：工作 M0 / 告警 X4~X7 / 急停 X0·X1 ============ -->
                    <Border Style="{StaticResource CardAlt}" Padding="12,7" CornerRadius="18" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <!-- 工作状态：M0 = ON 亮绿 -->
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="12" Height="12" VerticalAlignment="Center">
                                    <Ellipse Fill="{Binding WorkLampBrush}" Opacity="0.20" />
                                    <Ellipse Width="7" Height="7"
                                             Fill="{Binding WorkLampBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{DynamicResource L.Header.WorkState}"
                                           Margin="6,0,0,0" FontSize="12"
                                           Foreground="{Binding WorkLampBrush}" />
                            </StackPanel>

                            <!-- 告警状态：X4 ~ X7 任一断开 = 亮橙 -->
                            <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                                <Grid Width="12" Height="12" VerticalAlignment="Center">
                                    <Ellipse Fill="{Binding AlarmLampBrush}" Opacity="0.20" />
                                    <Ellipse Width="7" Height="7"
                                             Fill="{Binding AlarmLampBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{DynamicResource L.Header.AlarmState}"
                                           Margin="6,0,0,0" FontSize="12"
                                           Foreground="{Binding AlarmLampBrush}" />
                            </StackPanel>

                            <!-- 急停状态：X0 / X1 任一急停 = 亮红 -->
                            <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                                <Grid Width="12" Height="12" VerticalAlignment="Center">
                                    <Ellipse Fill="{Binding EmergencyLampBrush}" Opacity="0.20" />
                                    <Ellipse Width="7" Height="7"
                                             Fill="{Binding EmergencyLampBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{DynamicResource L.Header.EmergencyState}"
                                           Margin="6,0,0,0" FontSize="12"
                                           Foreground="{Binding EmergencyLampBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button Content="{DynamicResource L.Header.Settings}"
                            Style="{StaticResource SmallButton}"
                            Margin="10,0,0,0"
                            Command="{Binding SettingsCommand}" />

                    <!-- 打开日志文件夹：现场排障时一键定位到程序目录下的 log -->
                    <Button Content="{DynamicResource L.Header.Log}"
                            Style="{StaticResource SmallButton}"
                            Margin="10,0,0,0"
                            Command="{Binding OpenLogCommand}" />

                    <Border Style="{StaticResource CardAlt}" Padding="12,7" CornerRadius="18" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding OperatorLabel}" Style="{StaticResource CaptionText}" />
                            <TextBlock Text="{Binding CurrentUserName}"
                                       FontSize="12"
                                       Foreground="{StaticResource B.Accent}"
                                       Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>

                    <Button Content="{DynamicResource L.Header.Logout}"
                            Style="{StaticResource SmallButton}"
                            Margin="10,0,0,0"
                            Command="{Binding LogoutCommand}" />
                </StackPanel>
            </Grid>

            <!-- ===================== 主体三栏 ===================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="312" />
                </Grid.ColumnDefinitions>

                <!-- 试验参数 -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Border Width="3" Height="16" CornerRadius="2" Background="{StaticResource B.Accent}" />
                            <TextBlock Text="{DynamicResource L.Section.Params}"
                                       Style="{StaticResource SectionTitle}"
                                       Margin="8,0,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,18,0,0">
                            <TextBlock Text="{DynamicResource L.Field.ProductName}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ProductNameBox"
                                     Style="{StaticResource InputTextBox}"
                                     IsEnabled="{Binding IsParameterEditable}"
                                     Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="{DynamicResource L.Field.ProductCode}" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                            <TextBox x:Name="ProductCodeBox"
                                     Style="{StaticResource InputTextBox}"
                                     IsEnabled="{Binding IsParameterEditable}"
                                     Text="{Binding ProductCode, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="{DynamicResource L.Field.Tester}" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                            <TextBox x:Name="TesterBox"
                                     Style="{StaticResource InputTextBox}"
                                     IsEnabled="{Binding IsParameterEditable}"
                                     Text="{Binding Tester, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="{DynamicResource L.Field.Station}" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0"
                                             Content="1"
                                             GroupName="Station"
                                             Style="{StaticResource SegmentRadio}"
                                             IsEnabled="{Binding IsParameterEditable}"
                                             IsChecked="{Binding IsStation1, Mode=TwoWay}" />
                                <RadioButton Grid.Column="1"
                                             Content="2"
                                             GroupName="Station"
                                             Style="{StaticResource SegmentRadio}"
                                             Margin="6,0"
                                             IsEnabled="{Binding IsParameterEditable}"
                                             IsChecked="{Binding IsStation2, Mode=TwoWay}" />
                                <RadioButton Grid.Column="2"
                                             Content="3"
                                             GroupName="Station"
                                             Style="{StaticResource SegmentRadio}"
                                             IsEnabled="{Binding IsParameterEditable}"
                                             IsChecked="{Binding IsStation3, Mode=TwoWay}" />
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource L.Field.SetCurrent}" Style="{StaticResource FieldLabel}" />
                                    <Grid>
                                        <TextBox x:Name="SetCurrentBox"
                                                 Style="{StaticResource InputTextBox}"
                                                 Padding="12,0,38,0"
                                                 FontFamily="Consolas"
                                                 FontSize="16"
                                                 IsEnabled="{Binding IsParameterEditable}"
                                                 Text="{Binding SetCurrentText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{DynamicResource L.Unit.Ka}"
                                                   Style="{StaticResource CaptionText}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,0,12,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource L.Field.SetTime}" Style="{StaticResource FieldLabel}" />
                                    <Grid>
                                        <TextBox x:Name="SetTimeBox"
                                                 Style="{StaticResource InputTextBox}"
                                                 Padding="12,0,38,0"
                                                 FontFamily="Consolas"
                                                 FontSize="16"
                                                 IsEnabled="{Binding IsParameterEditable}"
                                                 Text="{Binding SetTimeText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{DynamicResource L.Unit.Second}"
                                                   Style="{StaticResource CaptionText}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,0,12,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 电流曲线：x:Name 供保存记录时整块渲染为 PNG 截图 -->
                <Border x:Name="ChartCard" Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,14,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3" Height="16" CornerRadius="2" Background="{StaticResource B.Accent}" />
                                <TextBlock Text="{DynamicResource L.Section.Chart}"
                                           Style="{StaticResource SectionTitle}"
                                           Margin="8,0,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{DynamicResource L.Readout.PeakCurrent}" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding PeakKa, StringFormat={}{0:F3}}"
                                           FontFamily="Consolas"
                                           FontSize="15"
                                           Foreground="{StaticResource B.Accent}"
                                           Margin="6,0,0,0" />
                                <TextBlock Text="{DynamicResource L.Unit.Ka}" Style="{StaticResource CaptionText}" Margin="4,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <controls:CurrentChart Grid.Row="1"
                                               Samples="{Binding Samples}"
                                               WindowSeconds="30"
                                               Margin="0,12,0,0" />
                    </Grid>
                </Border>

                <!-- 实时数据 -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{DynamicResource L.Readout.RealtimeCurrent}" Style="{StaticResource CaptionText}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding CurrentKa, StringFormat={}{0:F3}}"
                                           FontFamily="Consolas"
                                           FontSize="44"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource B.Accent}" />
                                <TextBlock Text="{DynamicResource L.Unit.Ka}"
                                           Style="{StaticResource UnitText}"
                                           FontSize="15"
                                           Margin="8,0,0,8" />
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Row="1" Height="1" Background="{StaticResource B.Border}" Margin="0,14" />

                        <!-- 运行时间：读取 D1600（ms ÷1000 = s），试验结束由 PLC 信号驱动 -->
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="{DynamicResource L.Readout.RunTime}" Style="{StaticResource CaptionText}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding RunTimeSeconds, StringFormat={}{0:F2}}"
                                           FontFamily="Consolas"
                                           FontSize="44"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource B.Accent}" />
                                <TextBlock Text="{DynamicResource L.Unit.Second}"
                                           Style="{StaticResource UnitText}"
                                           FontSize="15"
                                           Margin="8,0,0,8" />
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Row="3" Height="1" Background="{StaticResource B.Border}" Margin="0,16,0,0" />

                        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="{DynamicResource L.Readout.Status}" Style="{StaticResource CaptionText}" />
                            <TextBlock Text="{Binding StatusText}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding StatusBrush}"
                                       Margin="12,0,0,0" />
                        </StackPanel>

                        <Border Grid.Row="5" VerticalAlignment="Bottom" Background="#FF0C1622" CornerRadius="8" Padding="14,12" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource L.Readout.TripCurrent}" Style="{StaticResource CaptionText}" Margin="0,0,0,9" />
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,9">
                                    <TextBlock Text="{Binding TripKa, StringFormat={}{0:F3}}" FontFamily="Consolas" FontSize="14" Foreground="{StaticResource B.Text}" />
                                    <TextBlock Text="{DynamicResource L.Unit.Ka}" Style="{StaticResource CaptionText}" Margin="4,0,0,0" />
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource L.Readout.PeakCurrent}" Style="{StaticResource CaptionText}" Margin="0,0,0,9" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,9">
                                    <TextBlock Text="{Binding PeakKa, StringFormat={}{0:F3}}" FontFamily="Consolas" FontSize="14" Foreground="{StaticResource B.Text}" />
                                    <TextBlock Text="{DynamicResource L.Unit.Ka}" Style="{StaticResource CaptionText}" Margin="4,0,0,0" />
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource L.Readout.RunTime}" Style="{StaticResource CaptionText}" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding RunTimeSeconds, StringFormat={}{0:F2}}" FontFamily="Consolas" FontSize="14" Foreground="{StaticResource B.Text}" />
                                    <TextBlock Text="{DynamicResource L.Unit.Second}" Style="{StaticResource CaptionText}" Margin="4,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================== 操作按钮 ===================== -->
            <Grid Grid.Row="2" Margin="4,14,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" />

                <!-- 中部：电容充电 / 开始测试 / 停止测试（同尺寸，窗口居中） -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{DynamicResource L.Button.Charge}"
                            Style="{StaticResource GhostButton}"
                            Width="160"
                            Height="54"
                            Command="{Binding ChargeCommand}" />
                    <Button Content="{DynamicResource L.Button.Start}"
                            Style="{StaticResource StartButton}"
                            Width="160"
                            Height="54"
                            Margin="12,0,0,0"
                            Command="{Binding StartCommand}" />
                    <Button Content="{DynamicResource L.Button.Stop}"
                            Style="{StaticResource StopButton}"
                            Width="160"
                            Height="54"
                            Margin="12,0,0,0"
                            Command="{Binding StopCommand}" />
                </StackPanel>

                <!-- 右侧：保存数据 / 历史记录 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource L.Button.Save}"
                            Style="{StaticResource GhostButton}"
                            Width="150"
                            Height="54"
                            Command="{Binding SaveCommand}" />
                    <Button Content="{DynamicResource L.Button.History}"
                            Style="{StaticResource GhostButton}"
                            Width="150"
                            Height="54"
                            Margin="12,0,0,0"
                            Command="{Binding HistoryCommand}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ===================== 浮动提示 ===================== -->
        <Border VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,96"
                MaxWidth="900"
                CornerRadius="8"
                Padding="20,12"
                Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#F00E2A22" />
                    <Setter Property="BorderBrush" Value="{StaticResource B.Success}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                            <Setter Property="Background" Value="#F02B1219" />
                            <Setter Property="BorderBrush" Value="{StaticResource B.Danger}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <TextBlock Text="{Binding ToastMessage}" FontSize="13" Foreground="{StaticResource B.Text}" />
        </Border>
    </Grid>
</UserControl>
