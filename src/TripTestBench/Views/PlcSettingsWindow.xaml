<Window x:Class="TripTestBench.Views.PlcSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="580"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI">

    <Border Margin="20"
            Background="{StaticResource B.Card}"
            BorderBrush="{StaticResource B.Border}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="28,22,28,24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.55" Color="#FF000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <TextBlock Text="{DynamicResource L.Settings.Title}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource L.Settings.Protocol}"
                           Style="{StaticResource CaptionText}"
                           Margin="0,6,0,0" />
            </StackPanel>

            <Border Grid.Row="1" Height="1" Background="{StaticResource B.Border}" Margin="0,16,0,20" />

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource L.Settings.Ip}" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="IpBox" Style="{StaticResource InputTextBox}" FontFamily="Consolas" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource L.Settings.Port}" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="PortBox" Style="{StaticResource InputTextBox}" FontFamily="Consolas" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource L.Settings.Poll}" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="PollBox" Style="{StaticResource InputTextBox}" FontFamily="Consolas" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource L.Settings.UnitId}" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="UnitBox" Style="{StaticResource InputTextBox}" FontFamily="Consolas" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="4" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource B.TextSecondary}" />
                    <Button x:Name="TestButton"
                            Content="{DynamicResource L.Button.TestConnection}"
                            Style="{StaticResource SmallButton}"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0"
                            Click="Test_OnClick" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="{DynamicResource L.Button.Cancel}"
                            Style="{StaticResource GhostButton}"
                            Width="96"
                            Height="40"
                            Margin="0,0,10,0"
                            Click="Cancel_OnClick" />
                    <Button Content="{DynamicResource L.Button.Apply}"
                            Style="{StaticResource PrimaryButton}"
                            Width="140"
                            Height="40"
                            Click="Apply_OnClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
