<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>TripTestBench</AssemblyName>
    <RootNamespace>TripTestBench</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>智能直流大电流发生器</Product>
    <Company>Industrial Control</Company>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>

    <!-- 应用程序图标：编译进 exe 的 Win32 资源，决定资源管理器 / 任务栏显示的程序图标 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Release 发布输出目录：src 同级目录下的 publish\。
         $(MSBuildThisFileDirectory) = csproj 所在目录（...\src\TripTestBench\），
         ..\..\publish\ 即工程根目录下的 publish\。
         发布命令不带 -o 参数时生效；无论工程拷贝到哪里都自适应 -->
    <PublishDir>$(MSBuildThisFileDirectory)..\..\publish\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="offset.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- 同一份 ico 再作为 WPF 资源打包，供窗口 Icon 属性（标题栏 / 任务栏 / Alt+Tab）使用 -->
    <None Remove="Assets\app.ico" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

</Project>
