<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===== 应用 ===== -->
    <sys:String x:Key="L.App.Title">过流脱扣试验台</sys:String>
    <sys:String x:Key="L.App.Subtitle">工业控制与数据采集系统</sys:String>
    <sys:String x:Key="L.App.Version">版本 1.0.0</sys:String>

    <!-- ===== 窗口 ===== -->
    <sys:String x:Key="L.Window.Minimize">最小化</sys:String>
    <sys:String x:Key="L.Window.Close">关闭</sys:String>

    <!-- ===== 登录 ===== -->
    <sys:String x:Key="L.Login.Welcome">欢迎登录</sys:String>
    <sys:String x:Key="L.Login.Subtitle">请输入账户信息以进入控制系统</sys:String>
    <sys:String x:Key="L.Login.UserName">用户名</sys:String>
    <sys:String x:Key="L.Login.Password">密码</sys:String>
    <sys:String x:Key="L.Login.Button">登 录</sys:String>
    <sys:String x:Key="L.Login.Error">用户名或密码错误</sys:String>
    <sys:String x:Key="L.Login.Hint">默认账户：admin / 123456</sys:String>
    <sys:String x:Key="L.Login.EmptyUser">请输入用户名</sys:String>
    <sys:String x:Key="L.Login.EmptyPassword">请输入密码</sys:String>

