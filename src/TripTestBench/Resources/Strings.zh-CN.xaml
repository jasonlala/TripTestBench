    <sys:String x:Key="L.Settings.UnitId">从站号</sys:String>
    <sys:String x:Key="L.Settings.Saved">通讯设置已保存，正在重新连接…</sys:String>
    <sys:String x:Key="L.Settings.Testing">正在测试连接…</sys:String>
