    <sys:String x:Key="L.Msg.Stopped">测试已停止</sys:String>
    <sys:String x:Key="L.Msg.ChargeTimeout">电容充电超时（20 秒未收到充电完成信号），已断开主回路，请检查充电回路</sys:String>
    <sys:String x:Key="L.Msg.Exported">已导出到：{0}</sys:String>
    <sys:String x:Key="L.Msg.ExportFailed">导出失败：{0}</sys:String>
    <sys:String x:Key="L.Msg.NoExportData">没有可导出的记录</sys:String>
