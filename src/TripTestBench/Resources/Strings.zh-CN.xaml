    <sys:String x:Key="L.History.Col.ProductCode">产品编号</sys:String>
    <sys:String x:Key="L.History.Col.Tester">试验员</sys:String>
    <sys:String x:Key="L.History.Col.Station">工位</sys:String>
    <sys:String x:Key="L.History.Col.SetCurrent">设定电流 (kA)</sys:String>
    <sys:String x:Key="L.History.Col.SetTime">设定时间 (s)</sys:String>
    <sys:String x:Key="L.History.Col.TripCurrent">脱扣电流 (kA)</sys:String>
    <sys:String x:Key="L.History.Col.RunTime">运行时间 (s)</sys:String>
