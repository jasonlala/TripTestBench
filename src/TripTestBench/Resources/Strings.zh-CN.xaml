    <sys:String x:Key="L.Dialog.ExcelFilter">Excel 工作簿 (*.xlsx)|*.xlsx</sys:String>
    <sys:String x:Key="L.Msg.PrintDone">已发送到打印机</sys:String>
    <sys:String x:Key="L.Msg.PrintFailed">打印失败：{0}</sys:String>
    <sys:String x:Key="L.Msg.NoChartImage">该记录未保存曲线截图</sys:String>

    <!-- 打印报表 -->
    <sys:String x:Key="L.Print.Title">过流脱扣试验记录</sys:String>
