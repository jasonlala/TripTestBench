    <sys:String x:Key="L.Header.Logout">退出登录</sys:String>
    <sys:String x:Key="L.Header.Operator">操作员</sys:String>

    <sys:String x:Key="L.Section.Params">试验参数</sys:String>
    <sys:String x:Key="L.Section.Chart">电流曲线</sys:String>
    <sys:String x:Key="L.Section.Readout">实时数据</sys:String>

    <sys:String x:Key="L.Field.ProductName">产品名称</sys:String>
    <sys:String x:Key="L.Field.ProductCode">产品编号</sys:String>
    <sys:String x:Key="L.Field.Tester">试验员</sys:String>
