    <sys:String x:Key="L.Chart.NoData">等待采集数据…</sys:String>
    <sys:String x:Key="L.Chart.CurrentAxis">电流 (kA)</sys:String>
    <sys:String x:Key="L.Chart.TimeAxis">时间 (s)</sys:String>
    <sys:String x:Key="L.Chart.Window">最近 {0} 秒</sys:String>

</ResourceDictionary>
