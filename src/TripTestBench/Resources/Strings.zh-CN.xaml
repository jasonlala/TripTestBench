    <sys:String x:Key="L.Msg.ConfirmTitle">操作确认</sys:String>
    <sys:String x:Key="L.Msg.ConfirmCharge">确认对电容进行充电？请确认现场人员已撤离、防护门已关闭。</sys:String>
    <sys:String x:Key="L.Msg.ConfirmStart">确认开始测试？测试过程中禁止打开防护门或触碰主回路。</sys:String>
    <sys:String x:Key="L.Msg.ConfirmStop">确认停止当前测试并断开输出？</sys:String>
    <sys:String x:Key="L.Msg.ConfirmLogout">确认退出当前账户并返回登录界面？</sys:String>
    <sys:String x:Key="L.Msg.ConfirmStopShutdown">测试正在进行，关闭软件将停止输出并断开主回路，确认退出？</sys:String>
    <sys:String x:Key="L.Msg.ConfirmExit">确认退出程序？</sys:String>
    <sys:String x:Key="L.Msg.ValidationTitle">输入校验</sys:String>
    <sys:String x:Key="L.Msg.ValidationProductName">请输入产品名称</sys:String>
    <sys:String x:Key="L.Msg.ValidationProductCode">请输入产品编号</sys:String>
    <sys:String x:Key="L.Msg.ValidationTester">请输入试验员</sys:String>
