    <sys:String x:Key="L.Settings.Ip">PLC IP 地址</sys:String>
    <sys:String x:Key="L.Settings.Port">端口</sys:String>
    <sys:String x:Key="L.Settings.Poll">轮询周期 (ms)</sys:String>
