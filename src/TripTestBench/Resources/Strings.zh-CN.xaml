    <sys:String x:Key="L.Data.ColTime">时间 (s)</sys:String>
    <sys:String x:Key="L.Data.ColCurrent">电流 (kA)</sys:String>
    <sys:String x:Key="L.History.Empty">暂无符合条件的试验记录</sys:String>

