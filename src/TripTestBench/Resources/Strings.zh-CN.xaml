    <sys:String x:Key="L.Header.PlcConnected">PLC 已连接</sys:String>
    <sys:String x:Key="L.Header.PlcDisconnected">PLC 未连接</sys:String>
    <sys:String x:Key="L.Header.PlcConnecting">正在连接</sys:String>
    <sys:String x:Key="L.Header.Settings">通讯设置</sys:String>
    <sys:String x:Key="L.Header.WorkState">工作状态</sys:String>
